        { "type": "uptime", "key": "󱑂 " },
        { "type": "packages", "key": "󰏖 " },
        { "type": "shell", "key": " " },
        { "type": "wm", "key": " " },
        { "type": "terminal", "key": " " },
        { "type": "cpu", "key": " " },
        { "type": "gpu", "key": " " },
        { "type": "memory", "key": " " },
        "break"
    ]
}

#####################
# Font
#####################

font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 15.0

#####################
# Window
#####################

window_padding_width 12

background_opacity 0.94

#####################
# Cursor
#####################

shell_intergration no-cursor
cursor_shape block
cursor_blink_interval 0

#####################
# Clipboard
#####################

copy_on_select yes

#####################
# Scrollback
#####################

scrollback_lines 100000

#####################
# Colors
#####################

foreground $FOREGROUND
background $BACKGROUND

selection_foreground $BACKGROUND
selection_background $SELECTION_BG

cursor $FOREGROUND
cursor_text_color $BACKGROUND

color0  $BACKGROUND
color1  $COLOR1
color2  $COLOR2
color3  $COLOR3
color4  $COLOR4
color5  $COLOR5
color6  $COLOR6
color7  $COLOR7

color8  $COLOR8
color9  $COLOR9
color10 $COLOR10
color11 $COLOR11
color12 $SELECTION_BG
color13 $COLOR13
color14 $COLOR14
color15 $COLOR15
